{
  "name": "frontend",
  "title": "XFusion",
  "description": "A cross-platform application built with Nextkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tauri": "cargo tauri",
    "debug:eval": "node cli/debug/eval.js",
    "debug:lazy-container": "tsx cli/debug/tests/lazy_container_dimensions.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --port 8888 --outDir dist",
    "dev:remote": "bash scripts/remote/dev.sh",
    "remote:setup": "bash scripts/remote/setup.sh",
    "remote:sync": "bash scripts/remote/sync.sh",
    "remote:backend": "bash scripts/remote/backend.sh",
    "remote:logs": "bash scripts/remote/backend.sh logs",
    "remote:forward": "bash scripts/remote/forward.sh",
    "lint": "oxlint src cli --deny-warnings",
    "format": "oxfmt src cli",
    "format:check": "oxfmt --check src cli",
    "typecheck": "tsc --noEmit",
    "check": "concurrently \"oxlint src cli --deny-warnings\" \"tsc --noEmit\"",
    "dev:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --outfile=src-tauri/src/inject.js --watch=forever --banner:js=\"// Generated by src-tauri/src/inject.ts\"",
    "build:injection": "esbuild src-tauri/src/inject.ts --bundle --format=esm --target=esnext --outfile=src-tauri/src/inject.js --minify --banner:js=\"// Generated by src-tauri/src/inject.ts\""
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.27.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "type": "module"
}
