# Rexec Remote Connection
# If not defined here, will fallback to your system shell environment variables.
REXEC_HUB=https://rexec.edgetool.workers.dev
REXEC_TOKEN=your_token

# Remote Environment Configurations (Optional)
# If REMOTE_DIR is unset, it will be dynamically detected from the remote agent's current working directory (<agent_cwd>/xfusion).
# REMOTE_DIR=/workspace/xfusion
# BACKEND_PORT=8000
